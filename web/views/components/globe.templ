package components

import "strconv"

templ Globe(data GlobeData) {
	<noscript><p>Enable JavaScript to explore the globe and compare weather. You can still <a href="/#sightings">browse every sighting</a>.</p></noscript>
	<div class="globe" data-globe id="globe-explorer">
		<div class="globe__toolbar">
			<p data-explorer-status aria-live="polite">Pick a glowing point to step into its weather.</p>
			<div>
				<button type="button" class="faceoff__action" data-rotation aria-pressed="false">Pause rotation</button>
				<button type="button" class="faceoff__action" data-choose hidden>Choose another place</button>
				<button type="button" class="faceoff__action" data-show-cards hidden>View selected sightings</button>
			</div>
		</div>
		<div class="globe__stage">
			<canvas class="three-scene globe__canvas" data-scene="globe" role="img" aria-label="A globe with a glowing point wherever animals were seen. Choose a location using the buttons below for keyboard access."></canvas>
			<div class="globe__tip" data-globe-tip hidden></div>
			<p class="globe__hint">Drag to turn · pick a glowing point<br/><span>Or choose from the places below</span></p>
		</div>
		<div class="faceoff" data-faceoff inert>
			<div class="faceoff__cards">
				@faceoffSlot("a")
				<div class="faceoff__vs" aria-hidden="true"><span>VS</span></div>
				@faceoffSlot("b")
			</div>
			<p class="faceoff__gap" data-gap aria-live="polite">Pick a point on the globe for card A, then another for card B, and the two sightings face off.</p>
			<dl class="faceoff__bars" data-bars hidden></dl>
			<div class="faceoff__actions" data-actions hidden>
				<button type="button" class="faceoff__action" data-swap hidden>Swap sides</button>
				<button type="button" class="faceoff__action" data-reset>Start again</button>
			</div>
		</div>
	</div>
	<details class="places" open>
		<summary>Places on the globe <span>{ strconv.Itoa(len(data.Spots)) }</span></summary>
		<ul>
			for i, spot := range data.Spots {
				<li>
					<button type="button" class="places__spot" data-spot={ strconv.Itoa(i) }>
						{ spot.Label }
						<span>{ strconv.Itoa(len(spot.Items)) }</span>
					</button>
				</li>
			}
		</ul>
	</details>
	<template id="faceoff-card">
		<article class="wxcard">
			<div class="wxcard__photo"><img alt="" loading="lazy"/></div>
			<div class="wxcard__body">
				<p class="wxcard__tag"></p>
				<h3 class="wxcard__name" tabindex="-1"></h3>
				<p class="wxcard__sci"></p>
				<p class="wxcard__place"></p>
				<p class="wxcard__weather">
					<svg class="wxline__icon" aria-hidden="true"><use></use></svg>
					<span class="wxcard__temp"></span>
					<span class="wxcard__wx"></span>
				</p>
				<p class="wxcard__by"></p>
				<div class="wxcard__others"></div>
				<a class="wxcard__link">Open sighting →</a>
			</div>
		</article>
	</template>
	@templ.JSONScript("globe-data", data)
}

templ faceoffSlot(side string) {
	<div class={ "faceoff__slot", "faceoff__slot--" + side } data-slot={ side }>
		<div class="weather-space" aria-hidden="true">
			@WeatherScene()
			<canvas class="three-scene weather-space__canvas" data-scene="weather" data-weather-side={ side }></canvas>
		</div>
		<div class="faceoff__content" data-slot-content>
			<div class="faceoff__empty">
				<span class="faceoff__letter">{ side }</span>
				if side == "a" {
					<p>Pick a point</p>
				} else {
					<p>Another place, another sky</p>
					<button type="button" class="faceoff__action" data-choose>Choose a second place ↗</button>
				}
			</div>
		</div>
	</div>
}
