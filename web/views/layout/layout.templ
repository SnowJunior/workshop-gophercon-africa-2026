package layout

import "workshop/web/views/components"

type BaseProps struct {
	Title       string
	Description string
	Page        string
}

templ Base(props BaseProps) {
	<!DOCTYPE html>
	<html lang="en-GB">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<link rel="icon" href="/assets/images/logo.svg" type="image/svg+xml"/>
			<link rel="manifest" href="/assets/manifest.json"/>
			<meta name="theme-color" content="#0D0A26"/>
			<title>{ props.Title }</title>
			if props.Description != "" {
				<meta name="description" content={ props.Description }/>
			}
			<script>document.documentElement.classList.add('js')</script>
			<script>addEventListener('pagereveal', (e) => { if (e.viewTransition) document.documentElement.classList.add('vt') })</script>
			<script type="importmap">
				{
					"imports": {
						"three": "https://cdn.jsdelivr.net/npm/three@0.186.1/build/three.module.js",
						"three/addons/": "https://cdn.jsdelivr.net/npm/three@0.186.1/examples/jsm/"
					}
				}
			</script>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
			<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;800&display=swap"/>
			<link rel="stylesheet" href={ asset("/assets/css/threejs.css") }/>
			<link rel="stylesheet" href={ asset("/assets/css/lightbox.css") }/>
			<link rel="stylesheet" href={ asset("/assets/css/reveal.css") }/>
			<link rel="stylesheet" href={ asset("/assets/css/app.css") }/>
			<link rel="stylesheet" href={ asset("/assets/css/transitions.css") }/>
			<link rel="stylesheet" href={ asset("/assets/css/explore.css") }/>
		</head>
		<body class={ templ.KV("page--"+props.Page, props.Page != "") }>
			<a class="skip" href="#main">Skip to content</a>
			@components.WeatherIcons()
			<header class="site-header">
				<a class="site-header__logo" href="/">
					<img src="/assets/images/logo.svg" alt="Wild Sightings, home" width="44" height="44"/>
				</a>
				<nav class="top-nav" aria-label="Main">
					<a href="/#top">Featured</a>
					<a href="/#sightings">Every sighting</a>
					if props.Page == "globe" {
						<a href="/globe" class="is-active" aria-current="page">Globe ↗</a>
					} else {
						<a href="/globe">Globe ↗</a>
					}
				</nav>
				if props.Page == "" {
					<form class="site-header__search" role="search" action="#sightings" data-search-form>
						<label class="visually-hidden" for="search">Search sightings</label>
						<input id="search" type="search" placeholder="Search animals, places…" autocomplete="off" data-search/>
						<button type="button" class="site-header__search-toggle" data-search-toggle aria-label="Search">
							<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="2.4"></circle><path d="m15.5 15.5 5 5" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"></path></svg>
						</button>
					</form>
				}
			</header>
			<main id="main">
				{ children... }
			</main>
			<footer class="site-footer">
				<img src="/assets/images/logo.svg" alt="" width="32" height="32"/>
				<p>Wild Sightings · records from <a href="https://www.gbif.org" rel="noopener">GBIF</a>, photos by their recorders.</p>
				<a href="#main">Back to top ↑</a>
			</footer>
			@components.Lightbox()
			<script src={ asset("/assets/js/lightbox.js") } defer></script>
			<script src={ asset("/assets/js/reveal.js") } defer></script>
			<script src={ asset("/assets/js/app.js") } defer></script>
			if props.Page == "globe" {
				<script src={ asset("/assets/js/faceoff.js") } defer></script>
				<script type="module" src={ asset("/assets/js/scenes/globe.js") }></script>
				<script type="module" src={ asset("/assets/js/scenes/weather.js") }></script>
			}
		</body>
	</html>
}
