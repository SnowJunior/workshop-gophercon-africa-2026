package pages

import (
	"workshop/internal/domain/sighting"
	"workshop/web/views/components"
	"workshop/web/views/layout"
)

templ Globe(sightings []sighting.Sighting) {
	@layout.Base(layout.BaseProps{
		Title: "Around the globe · Wild Sightings",
		Description: "Explore wildlife around the world and step into the weather of each sighting.",
		Page: "globe",
	}) {
		<section class="section section--globe globe-page" aria-labelledby="globe-title">
			<header class="globe-page__head">
				<p class="section__kicker">An open-world field trip</p>
				<h1 id="globe-title">Around the globe<span class="slide__dot" aria-hidden="true"></span></h1>
				<p>Different places. Different skies. A world of wildlife.</p>
			</header>
			if data := components.NewGlobeData(sightings); len(data.Spots) > 0 {
				@components.Globe(data)
			} else {
				<p class="section__empty">No sightings with locations yet. Check back after sightings have been added.</p>
			}
		</section>
	}
}
